<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cnord.conductor-cleanup</string>
    <!-- launchd does not expand $HOME or ~ in plist paths, so a hardcoded home
         directory here breaks for every user but the author. Let bash expand
         it. No Standard{Out,Error}Path either: the script tees to
         $HOME/Library/Logs/conductor-cleanup.log itself. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec "$HOME/bin/conductor-cleanup.sh"</string>
    </array>
    <!-- Daily at noon: Mac is usually awake, and launchd coalesces a missed run
         on wake rather than skipping it. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>12</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
