# Personal Codex credentials resolved by Varlock on this machine.
# The Keychain items contain the values; this file contains only their references.

# @sensitive @required
SAIL_CLB_API_KEY=keychain(service="varlock", account="codex:local:SAIL_CLB_API_KEY")

# @required
SAIL_BASE_URL=keychain(service="varlock", account="codex:local:SAIL_BASE_URL")
