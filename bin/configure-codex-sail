#!/usr/bin/env bash

set -euo pipefail

# CODEX_LOAD_BALANCER=off removes the managed Sail provider instead of writing
# it, so Codex falls back to Conductor's own login. Set it as a Conductor cloud
# environment variable; the boot hook reapplies it on every workspace restart.
case "${CODEX_LOAD_BALANCER:-on}" in
  off | 0 | false) sail_mode=off ;;
  *) sail_mode=on ;;
esac

if [[ "$sail_mode" == on ]] &&
  [[ -z "${SAIL_CLB_API_KEY:-}" || -z "${SAIL_BASE_URL:-}" ]] &&
  [[ "${1:-}" != "--from-varlock" ]] &&
  command -v varlock >/dev/null 2>&1 &&
  [[ -r "$HOME/.env.codex" ]]; then
  exec varlock run \
    --inject vars \
    --filter SAIL_CLB_API_KEY,SAIL_BASE_URL \
    -p "$HOME/.env.codex" \
    -- "$0" --from-varlock
fi

if [[ "${1:-}" == "--from-varlock" ]]; then
  shift
fi

if [[ "$sail_mode" == on ]] &&
  [[ -z "${SAIL_CLB_API_KEY:-}" || -z "${SAIL_BASE_URL:-}" ]]; then
  echo "Skipping Sail Codex setup: SAIL_CLB_API_KEY and SAIL_BASE_URL are not both available from the environment or ~/.env.codex" >&2
  exit 0
fi

codex_home="${CODEX_HOME:-$HOME/.codex}"
mkdir -p "$codex_home"
chmod 700 "$codex_home"
umask 077

CODEX_HOME_PATH="$codex_home" SAIL_MODE="$sail_mode" python3 <<'PY'
import json
import os
import re
from pathlib import Path

codex_home = Path(os.environ["CODEX_HOME_PATH"])
sail_mode = os.environ["SAIL_MODE"]
api_key = os.environ.get("SAIL_CLB_API_KEY", "")
base_url = os.environ.get("SAIL_BASE_URL", "")

auth_path = codex_home / "auth.json"
if sail_mode == "on":
    auth_path.write_text(
        json.dumps(
            {
                "auth_mode": "apikey",
                "OPENAI_API_KEY": api_key,
            },
            indent=2,
        )
        + "\n"
    )
    auth_path.chmod(0o600)
elif auth_path.exists():
    # Only remove the API-key login this script writes, never a ChatGPT login.
    try:
        auth = json.loads(auth_path.read_text())
    except ValueError:
        auth = None
    if (
        isinstance(auth, dict)
        and set(auth) == {"auth_mode", "OPENAI_API_KEY"}
        and auth["auth_mode"] == "apikey"
        and (not api_key or auth["OPENAI_API_KEY"] == api_key)
    ):
        auth_path.unlink()

config_path = codex_home / "config.toml"
lines = config_path.read_text().splitlines(keepends=True) if config_path.exists() else []

# Remove a previous managed provider block and the root provider selection.
filtered = []
inside_sail_provider = False
before_first_table = True
for line in lines:
    stripped = line.strip()
    if stripped in {
        "# Managed by ~/dotfiles/bin/configure-codex-sail",
        "# Managed by ~/dotfiles/bin/configure-codex-sail-cloud",
    }:
        continue
    if stripped == "[model_providers.sail]":
        inside_sail_provider = True
        before_first_table = False
        continue
    if inside_sail_provider and stripped.startswith("["):
        inside_sail_provider = False
    if inside_sail_provider:
        continue
    if before_first_table and re.match(r"^model_provider\s*=", stripped):
        continue
    if stripped.startswith("["):
        before_first_table = False
    filtered.append(line)

if sail_mode == "off":
    config_path.write_text("".join(filtered))
    raise SystemExit(0)

first_table = next(
    (index for index, line in enumerate(filtered) if line.strip().startswith("[")),
    len(filtered),
)
filtered.insert(first_table, 'model_provider = "sail"\n')

config = "".join(filtered).strip() + "\n\n"
config += f"""# Managed by ~/dotfiles/bin/configure-codex-sail
[model_providers.sail]
name = "openai"
base_url = "{base_url}"
wire_api = "responses"
env_key = "SAIL_CLB_API_KEY"
supports_websockets = false
"""
config_path.write_text(config)
config_path.chmod(0o600)
PY

unset SAIL_CLB_API_KEY SAIL_BASE_URL
if [[ "$sail_mode" == off ]]; then
  echo "Removed the Sail provider from Codex (CODEX_LOAD_BALANCER=off)"
else
  echo "Configured Codex to use Sail"
fi
